rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPublished(res) {
      return res.data.status == 'published';
    }

    // Lets signed-in readers bump a single counter field by exactly 1 (or -1, for
    // fields that can be undone, e.g. unliking/deleting) — used for the viewCount,
    // likeCount, and commentCount writes readers trigger directly, without opening
    // stories/chapters up to arbitrary client edits.
    function isCounterBump(before, after, field, allowDecrement) {
      return after.data.diff(before.data).affectedKeys().hasOnly([field]) &&
        (after.data[field] == before.data[field] + 1 ||
          (allowDecrement && after.data[field] == before.data[field] - 1));
    }

    // Singleton "Sobre mí" / site profile doc — public read, admin write only.
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin allowlist — never client-writable; managed by hand in the console.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Per-reader private data: favorite stories and reading history.
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /stories/{storyId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() &&
          (isCounterBump(resource, request.resource, 'viewCount', false) ||
            isCounterBump(resource, request.resource, 'likeCount', true)));
      allow delete: if isAdmin();

      // Story-level likes: one doc per liker, doc ID == uid.
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      match /chapters/{chapterId} {
        allow read: if isPublished(resource) || isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin() ||
          (isSignedIn() &&
            (isCounterBump(resource, request.resource, 'viewCount', false) ||
              isCounterBump(resource, request.resource, 'likeCount', true) ||
              isCounterBump(resource, request.resource, 'commentCount', true)));
        allow delete: if isAdmin();

        match /likes/{uid} {
          allow read: if true;
          allow create, delete: if isSignedIn() && request.auth.uid == uid;
          allow update: if false;
        }

        match /comments/{commentId} {
          allow read: if true;
          allow create: if isSignedIn() &&
            get(/databases/$(database)/documents/stories/$(storyId)).data.commentsEnabled == true &&
            request.resource.data.authorUid == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 1000;
          allow delete: if isAdmin() ||
            (isSignedIn() && resource.data.authorUid == request.auth.uid);
          allow update: if false;
        }
      }
    }
  }
}
