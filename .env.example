# Copiá este archivo a .env.local y completá con los valores de tu proyecto Firebase
# (Configuración del proyecto > Tus apps > SDK setup and configuration > Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (hosteo gratuito de imágenes: portadas y foto de perfil)
# cloudinary.com > Dashboard > Cloud name, y Settings > Upload > un preset "unsigned"
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
